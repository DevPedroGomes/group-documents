# Todas as envs que o backend e o worker leem (app/config/settings.py e o
# pacote agent_ops), e so elas. No docker-compose, DATABASE_URL, JWT_SECRET,
# UPLOADS_PATH, REDIS_URL, CORS_ORIGINS e AGENT_OPS_* vem do bloco
# `environment:` e valem por cima deste arquivo. Fora segredos e enderecos
# (hosts do compose), os valores sao os defaults do codigo.

# --- App
APP_NAME=BrainHub Team API
# true expoe /docs e /openapi.json. Nunca em producao.
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# --- Banco (obrigatorio). O driver asyncpg e trocado por psycopg2 no boot.
DATABASE_URL=postgresql+asyncpg://brainhub:changeme@postgres:5432/brainhub

# --- Auth (JWT_SECRET obrigatorio: gere um aleatorio com 32+ bytes)
JWT_SECRET=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Rate limit por IP do cadastro e do login.
AUTH_RATE_LIMIT=5/minute

# --- Arquivos
UPLOADS_PATH=/app/uploads
# Em bytes (20 MB). Upload maior vira 413.
MAX_FILE_SIZE=20971520
# PDF com mais paginas falha como permanente, antes de qualquer chamada paga.
MAX_PDF_PAGES=300

# --- LLM: "anthropic" (SDK nativo) ou "openrouter" (OpenAI-compat)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Com LLM_PROVIDER=openrouter, os modelos sao ids do OpenRouter
# (ex.: anthropic/claude-haiku-4.5).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GENERATION_MODEL=claude-sonnet-5
FAST_MODEL=claude-haiku-4-5

# --- Embedding (Voyage). VOYAGE_API_KEY obrigatorio.
VOYAGE_API_KEY=
# Texto, imagem e video no MESMO espaco vetorial: um modelo so de texto aqui
# quebra a ingestao de imagem, video e pagina escaneada.
VOYAGE_DOC_MODEL=voyage-multimodal-3.5
# Tem que bater com o vector(N) das migrations (migrations/002). Mudar exige nova migration.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_CACHE_TTL=3600

# --- PDF escaneado: abaixo deste numero de caracteres a pagina vai para o
# caminho visual (render + visao + embedding de imagem).
PDF_MIN_CHARS_POR_PAGINA=120
PDF_RENDER_DPI=150

# --- Rerank (Cohere), opcional. Sem chave, a busca fica na ordem do RRF.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-fast
ENABLE_RERANKING=true

# --- RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SEARCH_CANDIDATES_MULTIPLIER=3
RELEVANCE_THRESHOLD=0.7
RRF_K=60
MULTI_QUERY_COUNT=3
ENABLE_CONFLICT_DETECTION=true
ENABLE_INPUT_GUARDRAILS=true

# --- Busca web (Tavily), opcional
# ENABLE_WEB_FALLBACK=true ENVIA A PERGUNTA DA PESSOA A UM TERCEIRO (Tavily).
# Desligado por padrao. Ligado, so roda quando o acervo nao responde nem depois
# da reconsulta, e nunca em pergunta com recorte no tempo (as_of).
ENABLE_WEB_FALLBACK=false
TAVILY_API_KEY=

# --- Audio (Deepgram). Sem chave, a ingestao de audio falha.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Conversa por voz (Realtime da OpenAI). Sem OPENAI_API_KEY a voz responde
# 503 e o resto do app segue igual.
ENABLE_REALTIME=true
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Redis do app (rate limit e cache de embedding)
REDIS_URL=redis://redis:6379

# --- Tetos diarios GLOBAIS, somando todo mundo (viram 429 ate a meia-noite UTC)
DAILY_CHAT_LIMIT=300
DAILY_INGEST_LIMIT=100
# Sessoes de voz abertas por dia.
DAILY_REALTIME_LIMIT=40
# Buscas que o agente de voz dispara por dia, somando todas as sessoes.
DAILY_REALTIME_TOOL_LIMIT=400

# --- Nucleo compartilhado (agent_ops). SEPARADO do REDIS_URL do app de proposito.
# O metering falha fechado: sem isto, toda chamada que consome cota vira 503.
AGENT_OPS_REDIS_URL=redis://redis:6379
AGENT_OPS_PROJETO=brainhub
# Fila acima disto recusa com 429. O compose usa 50; o default do pacote e 500.
AGENT_OPS_PROFUNDIDADE_MAXIMA=500
# true recusa toda chamada que consome cota. O codigo le a env a cada chamada,
# mas a env de um container em pe nao muda: ligar exige recriar o container do
# backend (docker compose up -d backend). Nao precisa de rebuild de imagem.
AGENT_OPS_KILL_SWITCH=false

# --- Script de semeadura do acervo demo (scripts/semear_acervo_demo.py), nao o app.
# Sem senha padrao: minimo 16 caracteres.
# ACERVO_DEMO_SENHA=
